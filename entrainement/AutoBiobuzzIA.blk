<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="bz1g5ddgh">MS_PAR_METRE</variable><variable id="bz20gatkk">MS_POUR_180_DEG</variable><variable id="bz3nz9efa">PUISSANCE_TIR</variable></variables><block type="procedures_defnoreturn" id="bz9zddvhbq" deletable="false" x="20" y="20"><field name="NAME">runOpMode</field><comment pinned="false" h="80" w="400">AUTO BIOBUZZ généré par BIOBUZZ Auto IA. Score espéré 41.7 pts. Ne modifiez que les 3 variables du début.</comment><statement name="STACK"><block type="comment" id="bz95vtm7wl"><field name="COMMENT">=== LES 3 VARIABLES A CALIBRER ===</field><next><block type="comment" id="bz96baqo9k"><field name="COMMENT">MS_PAR_METRE : temps (ms) pour avancer de 1 m</field><next><block type="variables_set" id="bz970c4wvm"><field name="VAR" id="bz1g5ddgh">MS_PAR_METRE</field><value name="VALUE"><block type="math_number" id="bz98wle1bi"><field name="NUM">1500</field></block></value><next><block type="comment" id="bz992yo2pi"><field name="COMMENT">MS_POUR_180_DEG : temps (ms) pour un demi-tour sur place</field><next><block type="variables_set" id="bz9a21y2hi"><field name="VAR" id="bz20gatkk">MS_POUR_180_DEG</field><value name="VALUE"><block type="math_number" id="bz9bcvftvf"><field name="NUM">1200</field></block></value><next><block type="comment" id="bz9c0mbz3v"><field name="COMMENT">PUISSANCE_TIR : puissance du lanceur (0 a 1)</field><next><block type="variables_set" id="bz9dwsfwtt"><field name="VAR" id="bz3nz9efa">PUISSANCE_TIR</field><value name="VALUE"><block type="math_number" id="bz9ev2oruu"><field name="NUM">0.85</field></block></value><next><block type="comment" id="bz9f3legs9"><field name="COMMENT">Conseil : moteurs des roues en ZeroPowerBehavior BRAKE (comme lors de la calibration)</field><next><block type="dcMotor_setProperty_Direction" id="bz9gay8pdq"><field name="IDENTIFIER">frontLeftAsDcMotor</field><field name="PROP">Direction</field><data>{"IDENTIFIER":"frontLeft"}</data><value name="VALUE