<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="bz1xh534s">MS_PAR_METRE</variable><variable id="bz2navsnx">MS_POUR_180_DEG</variable><variable id="bz3wjj470">PUISSANCE_TIR</variable></variables><block type="procedures_defnoreturn" id="bzabq09sst" deletable="false" x="20" y="20"><field name="NAME">runOpMode</field><comment pinned="false" h="80" w="400">AUTO BIOBUZZ généré par BIOBUZZ Auto IA. Score espéré 41.7 pts. Ne modifiez que les 3 variables du début.</comment><statement name="STACK"><block type="comment" id="bz9huag7ro"><field name="COMMENT">=== LES 3 VARIABLES A CALIBRER ===</field><next><block type="comment" id="bz9iw27z19"><field name="COMMENT">MS_PAR_METRE : temps (ms) pour avancer de 1 m</field><next><block type="variables_set" id="bz9jqirl45"><field name="VAR" id="bz1xh534s">MS_PAR_METRE</field><value name="VALUE"><block type="math_number" id="bz9k3kags4"><field name="NUM">1500</field></block></value><next><block type="comment" id="bz9lhp0yj1"><field name="COMMENT">MS_POUR_180_DEG : temps (ms) pour un demi-tour sur place</field><next><block type="variables_set" id="bz9m1atjiw"><field name="VAR" id="bz2navsnx">MS_POUR_180_DEG</field><value name="VALUE"><block type="math_number" id="bz9n5ghw37"><field name="NUM">1200</field></block></value><next><block type="comment" id="bz9oswa9sh"><field name="COMMENT">PUISSANCE_TIR : puissance du lanceur (0 a 1)</field><next><block type="variables_set" id="bz9ph8h5hc"><field name="VAR" id="bz3wjj470">PUISSANCE_TIR</field><value name="VALUE"><block type="math_number" id="bz9q8709qc"><field name="NUM">0.85</field></block></value><next><block type="comment" id="bz9rk13p0m"><field name="COMMENT">Conseil : moteurs des roues en ZeroPowerBehavior BRAKE (comme lors de la calibration)</field><next><block type="dcMotor_setProperty_Direction" id="bz9sq5g8yg"><field name="IDENTIFIER">frontLeftAsDcMotor</field><field name="PROP">Direction</field><data>{"IDENTIFIER":"frontLeft"}</data><value name="VALUE"><shadow type="dcMotor_typedEnum_direction" id="bz9tdguwt9"><field name="DIRECTION">REVERSE</field></shadow></value><next><block type="dcMotor_setProperty_Direction" id="bz9u15y83u"><field name="IDENTIFIER">backLeftAsDcMotor</field><field name="PROP">Direction</field><data>{"IDENTIFIER":"backLeft"}</data><value name="VALUE"><shadow type="dcMotor_typedEnum_direction" id="bz9vvlb1kr"><field name="DIRECTION">REVERSE</field></shadow></value><next><block type="comment" id="bz9wk8zcnj"><field name="COMMENT">Repère : vous êtes dans votre ALLIANCE AREA et vous regardez le terrain.</field><next><block type="comment" id="bz9x6k612b"><field name="COMMENT">Bord du robot le plus proche de votre alliance : 0 cm du mur de votre alliance.</field><next><block type="comment" id="bz9y6jwjjf"><field name="COMMENT">Bord du robot côté droit : 8 cm du mur de droite ; côté gauche : 308 cm du mur de gauche.</field><next><block type="comment" id="bz9zuattv2"><field name="COMMENT">Orientation : l'avant du robot regarde vers le centre du terrain (dos au mur de votre alliance).</field><next><block type="linearOpMode_waitForStart" id="bza06wdc09"><next><block type="controls_if" id="bza1j53gyh"><value name="IF0"><block type="linearOpMode_opModeIsActive" id="bza24kop8v"/></value><statement name="DO0"><block type="comment" id="bz4jzz1e7"><field name="COMMENT">--- Séquence trouvée par l'IA BIOBUZZ ---</field><next><block type="comment" id="bz549ilhh"><field name="COMMENT">t=0.0 s Lanceur ON</field><next><block type="dcMotor_setProperty_Number" id="bz89h74wp"><field name="IDENTIFIER">launcherAsDcMotor</field><field name="PROP">Power</field><data>{"IDENTIFIER":"launcher"}</data><value name="VALUE"><shadow type="math_number" id="bz6ej56vy"><field name="NUM">0</field></shadow><block type="variables_get" id="bz7zm2cqg"><field name="VAR" id="bz3wjj470">PUISSANCE_TIR</field></block></value><next><block type="comment" id="bz95b5tci"><field name="COMMENT">t=0.0 s Vers position de tir</field><next><block typ