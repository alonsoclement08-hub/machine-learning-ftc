<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="bz1q32p8q">MS_PAR_METRE</variable><variable id="bz2a5llwb">MS_POUR_180_DEG</variable><variable id="bz335nzj2">PUISSANCE_TIR</variable></variables><block type="procedures_defnoreturn" id="bzasftf9to" deletable="false" x="20" y="20"><field name="NAME">runOpMode</field><comment pinned="false" h="80" w="400">AUTO BIOBUZZ généré par BIOBUZZ Auto IA. Score espéré 47.2 pts. Ne modifiez que les 3 variables du début.</comment><statement name="STACK"><block type="comment" id="bz9yelt5l0"><field name="COMMENT">=== LES 3 VARIABLES A CALIBRER ===</field><next><block type="comment" id="bz9zyng0k2"><field name="COMMENT">MS_PAR_METRE : temps (ms) pour avancer de 1 m</field><next><block type="variables_set" id="bza0i6wa3e"><field name="VAR" id="bz1q32p8q">MS_PAR_METRE</field><value name="VALUE"><block type="math_number" id="bza1cunzxe"><field name="NUM">1500</field></block></value><next><block type="comment" id="bza26osoyz"><field name="COMMENT">MS_POUR_180_DEG : temps (ms) pour un demi-tour sur place</field><next><block type="variables_set" id="bza39updpz"><field name="VAR" id="bz2a5llwb">MS_POUR_180_DEG</field><value name="VALUE"><block type="math_number" id="bza4qnwnhl"><field name="NUM">1200</field></block></value><next><block type="comment" id="bza5dveq4b"><field name="COMMENT">PUISSANCE_TIR : puissance du lanceur (0 a 1)</field><next><block type="variables_set" id="bza6aoizsh"><field name="VAR" id="bz335nzj2">PUISSANCE_TIR</field><value name="VALUE"><block type="math_number" id="bza7xydscz"><field name="NUM">0.85</field></block></value><next><block type="comment" id="bza81ves2v"><field name="COMMENT">Conseil : moteurs des roues en ZeroPowerBehavior BRAKE (comme lors de la calibration)</field><next><block type="dcMotor_setProperty_Direction" id="bza9evy6xh"><field name="IDENTIFIER">frontLeftAsDcMotor</field><field name="PROP">Direction</field><data>{"IDENTIFIER":"frontLeft"}</data><value name="VALUE