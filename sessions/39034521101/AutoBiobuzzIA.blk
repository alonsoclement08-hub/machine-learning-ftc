<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="bz1fuc94g">MS_PAR_METRE</variable><variable id="bz2tsa6ht">MS_POUR_180_DEG</variable><variable id="bz3wl9i8w">PUISSANCE_TIR</variable></variables><block type="procedures_defnoreturn" id="bzasnggnra" deletable="false" x="20" y="20"><field name="NAME">runOpMode</field><comment pinned="false" h="80" w="400">AUTO BIOBUZZ généré par BIOBUZZ Auto IA. Score espéré 47.2 pts. Ne modifiez que les 3 variables du début.</comment><statement name="STACK"><block type="comment" id="bz9yi7un41"><field name="COMMENT">=== LES 3 VARIABLES A CALIBRER ===</field><next><block type="comment" id="bz9zk9jb3o"><field name="COMMENT">MS_PAR_METRE : temps (ms) pour avancer de 1 m</field><next><block type="variables_set" id="bza0k2pqxr"><field name="VAR" id="bz1fuc94g">MS_PAR_METRE</field><value name="VALUE"><block type="math_number" id="bza1fx3gzy"><field name="NUM">1500</field></block></value><next><block type="comment" id="bza25jw7yl"><field name="COMMENT">MS_POUR_180_DEG : temps (ms) pour un demi-tour sur place</field><next><block type="variables_set" id="bza3cbabkd"><field name="VAR" id="bz2tsa6ht">MS_POUR_180_DEG</field><value name="VALUE"><block type="math_number" id="bza41uh89s"><field name="NUM">1200</field></block></value><next><block type="comment" id="bza5n769lg"><field name="COMMENT">PUISSANCE_TIR : puissance du lanceur (0 a 1)</field><next><block type="variables_set" id="bza6ct0c25"><field name="VAR" id="bz3wl9i8w">PUISSANCE_TIR</field><value name="VALUE"><block type="math_number" id="bza72wyqm3"><field name="NUM">0.85</field></block></value><next><block type="comment" id="bza8hufcah"><field name="COMMENT">Conseil : moteurs des roues en ZeroPowerBehavior BRAKE (comme lors de la calibration)</field><next><block type="dcMotor_setProperty_Direction" id="bza92xfp0m"><field name="IDENTIFIER">frontLeftAsDcMotor</field><field name="PROP">Direction</field><data>{"IDENTIFIER":"frontLeft"}</data><value name="VALUE