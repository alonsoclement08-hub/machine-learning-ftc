<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="bz1e7tehq">MS_PAR_METRE</variable><variable id="bz2wh4ruy">MS_POUR_180_DEG</variable><variable id="bz3lmz69u">PUISSANCE_TIR</variable></variables><block type="procedures_defnoreturn" id="bzasuavr82" deletable="false" x="20" y="20"><field name="NAME">runOpMode</field><comment pinned="false" h="80" w="400">AUTO BIOBUZZ généré par BIOBUZZ Auto IA. Score espéré 47.2 pts. Ne modifiez que les 3 variables du début.</comment><statement name="STACK"><block type="comment" id="bz9y2gi4y1"><field name="COMMENT">=== LES 3 VARIABLES A CALIBRER ===</field><next><block type="comment" id="bz9z42b3qs"><field name="COMMENT">MS_PAR_METRE : temps (ms) pour avancer de 1 m</field><next><block type="variables_set" id="bza0xh0rsi"><field name="VAR" id="bz1e7tehq">MS_PAR_METRE</field><value name="VALUE"><block type="math_number" id="bza1lahkod"><field name="NUM">1500</field></block></value><next><block type="comment" id="bza2x80xs5"><field name="COMMENT">MS_POUR_180_DEG : temps (ms) pour un demi-tour sur place</field><next><block type="variables_set" id="bza31lgoa7"><field name="VAR" id="bz2wh4ruy">MS_POUR_180_DEG</field><value name="VALUE"><block type="math_number" id="bza4yyg8jd"><field name="NUM">1200</field></block></value><next><block type="comment" id="bza5af0hwv"><field name="COMMENT">PUISSANCE_TIR : puissance du lanceur (0 a 1)</field><next><block type="variables_set" id="bza6ik9993"><field name="VAR" id="bz3lmz69u">PUISSANCE_TIR</field><value name="VALUE"><block type="math_number" id="bza7valu7e"><field name="NUM">0.85</field></block></value><next><block type="comment" id="bza80eqq7v"><field name="COMMENT">Conseil : moteurs des roues en ZeroPowerBehavior BRAKE (comme lors de la calibration)</field><next><block type="dcMotor_setProperty_Direction" id="bza9oxyj22"><field name="IDENTIFIER">frontLeftAsDcMotor</field><field name="PROP">Direction</field><data>{"IDENTIFIER":"frontLeft"}</data><value name="VALUE