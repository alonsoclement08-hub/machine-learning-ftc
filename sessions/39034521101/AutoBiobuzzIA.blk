<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="bz1xp2m23">MS_PAR_METRE</variable><variable id="bz2x38kan">MS_POUR_180_DEG</variable><variable id="bz3dr3dkk">PUISSANCE_TIR</variable></variables><block type="procedures_defnoreturn" id="bzasvx1plj" deletable="false" x="20" y="20"><field name="NAME">runOpMode</field><comment pinned="false" h="80" w="400">AUTO BIOBUZZ généré par BIOBUZZ Auto IA. Score espéré 47.2 pts. Ne modifiez que les 3 variables du début.</comment><statement name="STACK"><block type="comment" id="bz9ydkor75"><field name="COMMENT">=== LES 3 VARIABLES A CALIBRER ===</field><next><block type="comment" id="bz9z35o0w0"><field name="COMMENT">MS_PAR_METRE : temps (ms) pour avancer de 1 m</field><next><block type="variables_set" id="bza0qj0kxk"><field name="VAR" id="bz1xp2m23">MS_PAR_METRE</field><value name="VALUE"><block type="math_number" id="bza1szejkf"><field name="NUM">1500</field></block></value><next><block type="comment" id="bza2yuifkz"><field name="COMMENT">MS_POUR_180_DEG : temps (ms) pour un demi-tour sur place</field><next><block type="variables_set" id="bza3smgkuc"><field name="VAR" id="bz2x38kan">MS_POUR_180_DEG</field><value name="VALUE"><block type="math_number" id="bza4gtqla8"><field name="NUM">1200</field></block></value><next><block type="comment" id="bza59ekkp5"><field name="COMMENT">PUISSANCE_TIR : puissance du lanceur (0 a 1)</field><next><block type="variables_set" id="bza6ns424j"><field name="VAR" id="bz3dr3dkk">PUISSANCE_TIR</field><value name="VALUE"><block type="math_number" id="bza77xb3ep"><field name="NUM">0.85</field></block></value><next><block type="comment" id="bza8f3z552"><field name="COMMENT">Conseil : moteurs des roues en ZeroPowerBehavior BRAKE (comme lors de la calibration)</field><next><block type="dcMotor_setProperty_Direction" id="bza91estq5"><field name="IDENTIFIER">frontLeftAsDcMotor</field><field name="PROP">Direction</field><data>{"IDENTIFIER":"frontLeft"}</data><value name="VALUE