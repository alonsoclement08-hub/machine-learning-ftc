<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="bz1zv1k9z">MS_PAR_METRE</variable><variable id="bz23j1ade">MS_POUR_180_DEG</variable><variable id="bz3u8qjvk">PUISSANCE_TIR</variable></variables><block type="procedures_defnoreturn" id="bzasse6glu" deletable="false" x="20" y="20"><field name="NAME">runOpMode</field><comment pinned="false" h="80" w="400">AUTO BIOBUZZ généré par BIOBUZZ Auto IA. Score espéré 47.2 pts. Ne modifiez que les 3 variables du début.</comment><statement name="STACK"><block type="comment" id="bz9yambcu5"><field name="COMMENT">=== LES 3 VARIABLES A CALIBRER ===</field><next><block type="comment" id="bz9zwz6s5e"><field name="COMMENT">MS_PAR_METRE : temps (ms) pour avancer de 1 m</field><next><block type="variables_set" id="bza03r2usn"><field name="VAR" id="bz1zv1k9z">MS_PAR_METRE</field><value name="VALUE"><block type="math_number" id="bza1vq8z2l"><field name="NUM">1500</field></block></value><next><block type="comment" id="bza25mx56h"><field name="COMMENT">MS_POUR_180_DEG : temps (ms) pour un demi-tour sur place</field><next><block type="variables_set" id="bza3lsveqg"><field name="VAR" id="bz23j1ade">MS_POUR_180_DEG</field><value name="VALUE"><block type="math_number" id="bza4ekie23"><field name="NUM">1200</field></block></value><next><block type="comment" id="bza55kx8nz"><field name="COMMENT">PUISSANCE_TIR : puissance du lanceur (0 a 1)</field><next><block type="variables_set" id="bza6jjmcv0"><field name="VAR" id="bz3u8qjvk">PUISSANCE_TIR</field><value name="VALUE"><block type="math_number" id="bza7lebb15"><field name="NUM">0.85</field></block></value><next><block type="comment" id="bza87k7nxj"><field name="COMMENT">Conseil : moteurs des roues en ZeroPowerBehavior BRAKE (comme lors de la calibration)</field><next><block type="dcMotor_setProperty_Direction" id="bza9wum7pv"><field name="IDENTIFIER">frontLeftAsDcMotor</field><field name="PROP">Direction</field><data>{"IDENTIFIER":"frontLeft"}</data><value name="VALUE