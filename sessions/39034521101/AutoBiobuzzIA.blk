<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="bz1x5vve2">MS_PAR_METRE</variable><variable id="bz2y22xhl">MS_POUR_180_DEG</variable><variable id="bz3naf7qm">PUISSANCE_TIR</variable></variables><block type="procedures_defnoreturn" id="bzassas5zl" deletable="false" x="20" y="20"><field name="NAME">runOpMode</field><comment pinned="false" h="80" w="400">AUTO BIOBUZZ généré par BIOBUZZ Auto IA. Score espéré 47.2 pts. Ne modifiez que les 3 variables du début.</comment><statement name="STACK"><block type="comment" id="bz9ytqdvdy"><field name="COMMENT">=== LES 3 VARIABLES A CALIBRER ===</field><next><block type="comment" id="bz9zaki8mk"><field name="COMMENT">MS_PAR_METRE : temps (ms) pour avancer de 1 m</field><next><block type="variables_set" id="bza0yhcoel"><field name="VAR" id="bz1x5vve2">MS_PAR_METRE</field><value name="VALUE"><block type="math_number" id="bza11tphdx"><field name="NUM">1500</field></block></value><next><block type="comment" id="bza2poalbu"><field name="COMMENT">MS_POUR_180_DEG : temps (ms) pour un demi-tour sur place</field><next><block type="variables_set" id="bza3xd8mr5"><field name="VAR" id="bz2y22xhl">MS_POUR_180_DEG</field><value name="VALUE"><block type="math_number" id="bza4exwl3y"><field name="NUM">1200</field></block></value><next><block type="comment" id="bza5hpj5p0"><field name="COMMENT">PUISSANCE_TIR : puissance du lanceur (0 a 1)</field><next><block type="variables_set" id="bza6wme3mn"><field name="VAR" id="bz3naf7qm">PUISSANCE_TIR</field><value name="VALUE"><block type="math_number" id="bza71z00p6"><field name="NUM">0.85</field></block></value><next><block type="comment" id="bza82ma37i"><field name="COMMENT">Conseil : moteurs des roues en ZeroPowerBehavior BRAKE (comme lors de la calibration)</field><next><block type="dcMotor_setProperty_Direction" id="bza9qbut1e"><field name="IDENTIFIER">frontLeftAsDcMotor</field><field name="PROP">Direction</field><data>{"IDENTIFIER":"frontLeft"}</data><value name="VALUE