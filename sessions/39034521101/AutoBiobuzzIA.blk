<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="bz1of1kd1">MS_PAR_METRE</variable><variable id="bz2w6dqlw">MS_POUR_180_DEG</variable><variable id="bz39m8c3u">PUISSANCE_TIR</variable></variables><block type="procedures_defnoreturn" id="bzas5ioqn5" deletable="false" x="20" y="20"><field name="NAME">runOpMode</field><comment pinned="false" h="80" w="400">AUTO BIOBUZZ généré par BIOBUZZ Auto IA. Score espéré 47.2 pts. Ne modifiez que les 3 variables du début.</comment><statement name="STACK"><block type="comment" id="bz9y9vfp3m"><field name="COMMENT">=== LES 3 VARIABLES A CALIBRER ===</field><next><block type="comment" id="bz9zlcfxeg"><field name="COMMENT">MS_PAR_METRE : temps (ms) pour avancer de 1 m</field><next><block type="variables_set" id="bza07bc9b8"><field name="VAR" id="bz1of1kd1">MS_PAR_METRE</field><value name="VALUE"><block type="math_number" id="bza1icivqe"><field name="NUM">1500</field></block></value><next><block type="comment" id="bza29y93uu"><field name="COMMENT">MS_POUR_180_DEG : temps (ms) pour un demi-tour sur place</field><next><block type="variables_set" id="bza38lkbak"><field name="VAR" id="bz2w6dqlw">MS_POUR_180_DEG</field><value name="VALUE"><block type="math_number" id="bza4its44o"><field name="NUM">1200</field></block></value><next><block type="comment" id="bza5gi1vwj"><field name="COMMENT">PUISSANCE_TIR : puissance du lanceur (0 a 1)</field><next><block type="variables_set" id="bza6ksanol"><field name="VAR" id="bz39m8c3u">PUISSANCE_TIR</field><value name="VALUE"><block type="math_number" id="bza7wo4szz"><field name="NUM">0.85</field></block></value><next><block type="comment" id="bza8tk1hve"><field name="COMMENT">Conseil : moteurs des roues en ZeroPowerBehavior BRAKE (comme lors de la calibration)</field><next><block type="dcMotor_setProperty_Direction" id="bza95axzxm"><field name="IDENTIFIER">frontLeftAsDcMotor</field><field name="PROP">Direction</field><data>{"IDENTIFIER":"frontLeft"}</data><value name="VALUE"><shadow type="dcMotor_typedEnum_direction" id="bzaa16a5sz"><field name="DIRECTION">REVERSE</field></shadow></value><next><block type="dcMotor_setProperty_Direction" id="bzab9l2xp4"><field name="IDENTIFIER">backLeftAsDcMotor</field><field name="PROP">Direction</field><data>{"IDENTIFIER":"backLeft"}</data><value name="VALUE"><shadow type="dcMotor_typedEnum_direction" id="bzacyvog03"><field name="DIRECTION">REVERSE</field></shadow></value><next><block type="comment" id="bzadzxnbm4"><field name="COMMENT">Repère : vous êtes dans votre ALLIANCE AREA et vous regardez le terrain.</field><next><block type="comment" id="bzaebb9wle"><field name="COMMENT">Bord du robot le plus proche de votre alliance : 53 cm du mur de votre alliance.</field><next><block type="comment" id="bzafdyknl3"><field name="COMMENT">Bord du robot côté droit : 0 cm du mur de droite ; côté gauche : 316 cm du mur de gauche.</field><next><block type="comment" id="bzag3oy45y"><field name="COMMENT">Orientation : l'avant du robot regarde vers votre gauche.</field><next><block type="linearOpMode_waitForStart" id="bzaha6zthh"><next><block type="controls_if" id="bzai06nulq"><value name="IF0"><block type="linearOpMode_opModeIsActive" id="bzajt92609"/></value><statement name="DO0"><block type="comment" id="bz4jo4qqa"><field name="COMMENT">--- Séquence trouvée par l'IA BIOBUZZ ---</field><next><block type="comment" id="bz54pyvu1"><field name="COMMENT">t=0.0 s Lanceur ON</field><next><block type="dcMotor_setProperty_Number" id="bz8eq3w0c"><field name="IDENTIFIER">launcherAsDcMotor</field><field name="PROP">Power</field><data>{"IDENTIFIER":"launcher"}</data><value name="VALUE"><shadow type="math_number" id="bz6zcj55q"><field name="NUM">0</field></shadow><block type="variables_get" id="bz78rq12v"><field name="VAR" id="bz39m8c3u">PUISSANCE_TIR</field></block></value><next><block type="comment" id="bz9jlrl7m"><field name="COMMENT">t=0.0 s Vers position de tir</field><next><block type="comment" id="bzac2413g"><field name