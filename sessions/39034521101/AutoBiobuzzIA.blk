<xml xmlns="https://developers.google.com/blockly/xml"><variables><variable id="bz1ca7tuy">MS_PAR_METRE</variable><variable id="bz2ljhri1">MS_POUR_180_DEG</variable><variable id="bz3rqvdoo">PUISSANCE_TIR</variable></variables><block type="procedures_defnoreturn" id="bzas5umc9x" deletable="false" x="20" y="20"><field name="NAME">runOpMode</field><comment pinned="false" h="80" w="400">AUTO BIOBUZZ généré par BIOBUZZ Auto IA. Score espéré 47.2 pts. Ne modifiez que les 3 variables du début.</comment><statement name="STACK"><block type="comment" id="bz9yzirgga"><field name="COMMENT">=== LES 3 VARIABLES A CALIBRER ===</field><next><block type="comment" id="bz9zqxv64m"><field name="COMMENT">MS_PAR_METRE : temps (ms) pour avancer de 1 m</field><next><block type="variables_set" id="bza0at8i64"><field name="VAR" id="bz1ca7tuy">MS_PAR_METRE</field><value name="VALUE"><block type="math_number" id="bza1sxf5bn"><field name="NUM">1500</field></block></value><next><block type="comment" id="bza2y6x1cu"><field name="COMMENT">MS_POUR_180_DEG : temps (ms) pour un demi-tour sur place</field><next><block type="variables_set" id="bza3aql4ko"><field name="VAR" id="bz2ljhri1">MS_POUR_180_DEG</field><value name="VALUE"><block type="math_number" id="bza40pkcij"><field name="NUM">1200</field></block></value><next><block type="comment" id="bza5auhk6u"><field name="COMMENT">PUISSANCE_TIR : puissance du lanceur (0 a 1)</field><next><block type="variables_set" id="bza6e9btdq"><field name="VAR" id="bz3rqvdoo">PUISSANCE_TIR</field><value name="VALUE"><block type="math_number" id="bza7wmypff"><field name="NUM">0.85</field></block></value><next><block type="comment" id="bza838t7gt"><field name="COMMENT">Conseil : moteurs des roues en ZeroPowerBehavior BRAKE (comme lors de la calibration)</field><next><block type="dcMotor_setProperty_Direction" id="bza9qmn84p"><field name="IDENTIFIER">frontLeftAsDcMotor</field><field name="PROP">Direction</field><data>{"IDENTIFIER":"frontLeft"}</data><value name="VALUE